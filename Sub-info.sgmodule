#!name=机场流量信息
#!desc=显示一至两个订阅的流量、到期日期及更新时间；未使用的链接保留 -，不查询、不显示。
#!system=ios
#!arguments=title_1:订阅链接 1,url_1:-,title_2:订阅链接 2,url_2:-
#!arguments-desc=title_1/2：自定义名称，保留 - 时使用默认名称。url_1/2：完整订阅链接，无需编码；不用的链接保留 -。只填一个就只显示一份，两份显示在同一面板。名称和链接中不要包含英文逗号或换行；名称不要包含 &。参数仅在本地填写，勿分享含私人链接的截图。

# 两个订阅共用一个面板，跳过未配置的订阅，不依赖未公开的隐藏面板接口。
# 如参数界面不允许清空，请保留 -，脚本将其视为未填写。
# 到期日期只采用订阅响应头，不预设套餐日期或流量重置日。
# 请更新模块后重新填写参数，旧 Sub-info.js 保留不变。

[Panel]
机场流量信息 = script-name=机场流量信息,update-interval=86400

[Script]
机场流量信息 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-optional.js,script-update-interval=86400,argument="title_1={{{title_1}}}&url_1={{{url_1}}}&title_2={{{title_2}}}&url_2={{{url_2}}}"
