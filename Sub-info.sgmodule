#!name=机场流量信息
#!desc=显示订阅流量、套餐到期日期及更新时间；订阅链接在 Surge 本地参数中填写。
#!system=ios
#!arguments=title_1:订阅链接 1,url_1,title_2:订阅链接 2,url_2
#!arguments-desc=title_1：订阅 1 的显示名称；url_1：订阅 1 的完整链接；title_2：订阅 2 的显示名称；url_2：订阅 2 的完整链接。链接直接粘贴，无需 URL Encode，不加引号；名称请勿包含 &、逗号或换行，如需特殊字符请先 URL Encode。参数保存在 Surge 本地，请勿分享含私人链接的截图。

# 使用方法：通过 Install New Module 安装本文件的 raw 链接，填写两个参数后启用。
# 本模块只引用现有 Sub-info.js，不包含任何私人订阅地址。
# 保留原模块的图标、颜色、刷新周期、重置日期及到期参数。
# &url=订阅地址必须位于 argument 最后，以保留订阅地址中的 & 参数。
# 第二个面板沿用原配置 reset_day=99 与 expire=1970-01-01；名称和链接参数不会调整这些套餐显示设置。

[Panel]
订阅链接1 = script-name=订阅链接1,update-interval=86400
订阅链接2 = script-name=订阅链接2,update-interval=86400

[Script]
订阅链接1 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info.js,script-update-interval=86400,argument=title={{{title_1}}}&reset_day=11&icon=externaldrive.fill.badge.icloud&color=#007aff&url={{{url_1}}}
订阅链接2 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info.js,script-update-interval=86400,argument=title={{{title_2}}}&reset_day=99&expire=1970-01-01&icon=externaldrive.fill.badge.icloud&color=#007aff&url={{{url_2}}}
