#!name=机场流量信息
#!desc=最多五个独立订阅面板；只启用已填写有效链接的面板。
#!system=ios
#!requirement=CORE_VERSION>=22
#!arguments=订阅 1 名称:订阅链接 1,订阅 1 链接:-,订阅 1 重置日:-,订阅 2 名称:订阅链接 2,订阅 2 链接:-,订阅 2 重置日:-,订阅 3 名称:订阅链接 3,订阅 3 链接:-,订阅 3 重置日:-,订阅 4 名称:订阅链接 4,订阅 4 链接:-,订阅 4 重置日:-,订阅 5 名称:订阅链接 5,订阅 5 链接:-,订阅 5 重置日:-
#!arguments-desc=🔒 隐私提示：本模块不会将订阅链接上传到 GitHub 或其他地方。\n链接由 Surge 保存在本地；查询流量时会请求您填写的订阅地址。Surge 自身的 iCloud 同步或系统备份不受本模块控制，因此不承诺“仅留在本机”。\n⚠️ 请勿分享含私人链接的参数截图、配置或备份。\n\n📝 填写方法\n• 名称：面板显示的机场名称，可自行修改。\n• 链接：粘贴机场提供的完整订阅地址，无需编码或加引号。\n• 不用的位置：链接保留 -，不会启用对应面板。\n• 填几个有效链接就启用几个独立面板，最多五个。\n• 重置日：填 1–31 显示剩余天数；填“长期”或“长期有效”显示“重置时间：长期有效”；保留 - 则不显示。重置当天按已重置计算，显示距离下次重置的天数；当月没有该日期时按月末计算。\n\n⚠️ 格式限制\n名称与链接不要包含英文逗号、英文单双引号或换行；名称不要含 &。\n需要 Surge iOS 5.11.0 或更新版本。

# 参数替换后，使用行条件判断 URL；未配置的行不生效，不依赖脚本返回空对象来隐藏面板。
# 到期信息来自订阅响应；每个订阅的每月重置日可选填，不预设套餐日期。
# 中文参数名直接显示在 Edit Arguments 左列。旧英文参数名已改名，更新后请重新填写。

[Panel]
#!REQUIREMENT "'{{{订阅 1 链接}}}' MATCHES '^https?://.+'" 订阅链接1 = script-name=订阅链接1,update-interval=86400
#!REQUIREMENT "'{{{订阅 2 链接}}}' MATCHES '^https?://.+'" 订阅链接2 = script-name=订阅链接2,update-interval=86400
#!REQUIREMENT "'{{{订阅 3 链接}}}' MATCHES '^https?://.+'" 订阅链接3 = script-name=订阅链接3,update-interval=86400
#!REQUIREMENT "'{{{订阅 4 链接}}}' MATCHES '^https?://.+'" 订阅链接4 = script-name=订阅链接4,update-interval=86400
#!REQUIREMENT "'{{{订阅 5 链接}}}' MATCHES '^https?://.+'" 订阅链接5 = script-name=订阅链接5,update-interval=86400

[Script]
#!REQUIREMENT "'{{{订阅 1 链接}}}' MATCHES '^https?://.+'" 订阅链接1 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js?v=b0e7e93f5701,script-update-interval=86400,argument="title={{{订阅 1 名称}}}&reset_day={{{订阅 1 重置日}}}&url={{{订阅 1 链接}}}"
#!REQUIREMENT "'{{{订阅 2 链接}}}' MATCHES '^https?://.+'" 订阅链接2 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js?v=b0e7e93f5701,script-update-interval=86400,argument="title={{{订阅 2 名称}}}&reset_day={{{订阅 2 重置日}}}&url={{{订阅 2 链接}}}"
#!REQUIREMENT "'{{{订阅 3 链接}}}' MATCHES '^https?://.+'" 订阅链接3 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js?v=b0e7e93f5701,script-update-interval=86400,argument="title={{{订阅 3 名称}}}&reset_day={{{订阅 3 重置日}}}&url={{{订阅 3 链接}}}"
#!REQUIREMENT "'{{{订阅 4 链接}}}' MATCHES '^https?://.+'" 订阅链接4 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js?v=b0e7e93f5701,script-update-interval=86400,argument="title={{{订阅 4 名称}}}&reset_day={{{订阅 4 重置日}}}&url={{{订阅 4 链接}}}"
#!REQUIREMENT "'{{{订阅 5 链接}}}' MATCHES '^https?://.+'" 订阅链接5 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js?v=b0e7e93f5701,script-update-interval=86400,argument="title={{{订阅 5 名称}}}&reset_day={{{订阅 5 重置日}}}&url={{{订阅 5 链接}}}"
