#!name=机场流量信息
#!desc=最多五个独立订阅面板；只启用已填写有效链接的面板。
#!system=ios
#!requirement=CORE_VERSION>=22
#!arguments=title_1:订阅链接 1,url_1:-,title_2:订阅链接 2,url_2:-,title_3:订阅链接 3,url_3:-,title_4:订阅链接 4,url_4:-,title_5:订阅链接 5,url_5:-
#!arguments-desc=title_1 至 title_5：各订阅的显示名称。url_1 至 url_5：对应完整订阅链接，不用的保留 -。填写几个链接就启用几个独立面板，最多五个。链接无需编码或引号；名称与链接请勿包含英文逗号、英文双引号、英文单引号或换行，名称不要含 &。此版本需要 Surge iOS 5.11.0 或更新版本。请勿分享包含私人链接的截图。

# 参数替换后，使用行条件判断 URL；未配置的行不生效，不依赖脚本返回空对象来隐藏面板。
# 到期信息来自订阅响应；不预设重置日或到期日期。
# 标题留默认值即可，未使用的 URL 保留 -。旧 title_1/url_1 等参数名保持兼容。

[Panel]
#!REQUIREMENT "'{{{url_1}}}' MATCHES '^https?://.+'" 订阅链接1 = script-name=订阅链接1,update-interval=86400
#!REQUIREMENT "'{{{url_2}}}' MATCHES '^https?://.+'" 订阅链接2 = script-name=订阅链接2,update-interval=86400
#!REQUIREMENT "'{{{url_3}}}' MATCHES '^https?://.+'" 订阅链接3 = script-name=订阅链接3,update-interval=86400
#!REQUIREMENT "'{{{url_4}}}' MATCHES '^https?://.+'" 订阅链接4 = script-name=订阅链接4,update-interval=86400
#!REQUIREMENT "'{{{url_5}}}' MATCHES '^https?://.+'" 订阅链接5 = script-name=订阅链接5,update-interval=86400

[Script]
#!REQUIREMENT "'{{{url_1}}}' MATCHES '^https?://.+'" 订阅链接1 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js,script-update-interval=86400,argument="title={{{title_1}}}&url={{{url_1}}}"
#!REQUIREMENT "'{{{url_2}}}' MATCHES '^https?://.+'" 订阅链接2 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js,script-update-interval=86400,argument="title={{{title_2}}}&url={{{url_2}}}"
#!REQUIREMENT "'{{{url_3}}}' MATCHES '^https?://.+'" 订阅链接3 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js,script-update-interval=86400,argument="title={{{title_3}}}&url={{{url_3}}}"
#!REQUIREMENT "'{{{url_4}}}' MATCHES '^https?://.+'" 订阅链接4 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js,script-update-interval=86400,argument="title={{{title_4}}}&url={{{url_4}}}"
#!REQUIREMENT "'{{{url_5}}}' MATCHES '^https?://.+'" 订阅链接5 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Eightean/Surge/main/Sub-info-panel.js,script-update-interval=86400,argument="title={{{title_5}}}&url={{{url_5}}}"
